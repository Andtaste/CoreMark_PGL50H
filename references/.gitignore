# Prebuilt ISA fixtures are reference inputs, not current firmware outputs.
!tinyriscv/tests/isa/generated/*.bin
!tinyriscv/tests/isa/generated/*.dump
!tinyriscv/tests/riscv-compliance/build_generated/**/*.bin
!tinyriscv/tests/riscv-compliance/build_generated/**/*.elf

# Keep future generated debug artifacts out of the snapshots.
*.vcd
*.fst
*.log
__pycache__/
