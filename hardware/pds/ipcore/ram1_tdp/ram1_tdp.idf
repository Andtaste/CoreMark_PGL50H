<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>02100201</id>
        <display_name>DRM Based Dual Port RAM</display_name>
        <version>1.8</version>
        <instance>ram1_tdp</instance>
        <family>Logos</family>
        <device>PGL50H</device>
        <package>FBG484</package>
        <speedgrade>-6</speedgrade>
        <generator version="2025.2" build="211867">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>A_ADDR_STROBE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>A_ADDR_WIDTH</name>
            <type>int</type>
            <value>13</value>
        </param>
        <param>
            <name>A_BE_WIDTH</name>
            <type>int</type>
            <value>8</value>
        </param>
        <param>
            <name>A_CLK_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>A_CLK_OR_POL_INV</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>A_DATA_WIDTH</name>
            <type>int</type>
            <value>64</value>
        </param>
        <param>
            <name>A_OUTPUT_REG</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>A_RD_OCE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>A_WRITE_MODE</name>
            <type>enum</type>
            <item>NORMAL_WRITE</item>
            <item>TRANSPARENT_WRITE</item>
            <item>READ_BEFORE_WRITE</item>
            <value>READ_BEFORE_WRITE</value>
        </param>
        <param>
            <name>BYTE_SIZE</name>
            <type>enum</type>
            <value>8</value>
        </param>
        <param>
            <name>B_ADDR_STROBE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>B_ADDR_WIDTH</name>
            <type>int</type>
            <value>13</value>
        </param>
        <param>
            <name>B_BE_WIDTH</name>
            <type>int</type>
            <value>8</value>
        </param>
        <param>
            <name>B_CLK_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>B_CLK_OR_POL_INV</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>B_DATA_WIDTH</name>
            <type>int</type>
            <value>64</value>
        </param>
        <param>
            <name>B_OUTPUT_REG</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>B_RD_OCE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>B_WRITE_MODE</name>
            <type>enum</type>
            <item>NORMAL_WRITE</item>
            <item>TRANSPARENT_WRITE</item>
            <item>READ_BEFORE_WRITE</item>
            <value>READ_BEFORE_WRITE</value>
        </param>
        <param>
            <name>DRM_MODE_SEL</name>
            <type>enum</type>
            <value>AUTO</value>
        </param>
        <param>
            <name>INIT_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>INIT_FILE</name>
            <type>string</type>
            <value>memory/boot64.dat</value>
        </param>
        <param>
            <name>INIT_FORMAT</name>
            <type>enum</type>
            <value>HEX</value>
        </param>
        <param>
            <name>MODE_18K</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>MODE_9K</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>POWER_OPT</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>RESET_TYPE</name>
            <type>enum</type>
            <value>ASYNC</value>
        </param>
        <param>
            <name>SAMEWIDTH_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>WR_BYTE_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>a_addr</name>
            <text>a_addr</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>12</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_wr_data</name>
            <text>a_wr_data</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>63</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_rd_data</name>
            <text>a_rd_data</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>63</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_wr_en</name>
            <text>a_wr_en</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>a_wr_byte_en</name>
            <text>a_wr_byte_en</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>7</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_clk</name>
            <text>a_clk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>a_clk_en</name>
            <text>a_clk_en</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>a_rst</name>
            <text>a_rst</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>b_addr</name>
            <text>b_addr</text>
            <dir>input</dir>
            <pos>right</pos>
            <msb>12</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_wr_data</name>
            <text>b_wr_data</text>
            <dir>input</dir>
            <pos>right</pos>
            <msb>63</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_rd_data</name>
            <text>b_rd_data</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>63</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_wr_en</name>
            <text>b_wr_en</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>b_wr_byte_en</name>
            <text>b_wr_byte_en</text>
            <dir>input</dir>
            <pos>right</pos>
            <msb>7</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_clk</name>
            <text>b_clk</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>b_clk_en</name>
            <text>b_clk_en</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>b_rst</name>
            <text>b_rst</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>a_rd_oce</name>
            <text>a_rd_oce</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>a_addr_strobe</name>
            <text>a_addr_strobe</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>b_rd_oce</name>
            <text>b_rd_oce</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>b_addr_strobe</name>
            <text>b_addr_strobe</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
    </pin_list>
    <synthesis>
        <script>set_option -vlog_std v2001</script>
        <script>set_option -disable_io_insertion 1</script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="ram1_tdp_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="ram1_tdp_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="ram1_tdp_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipml_dpram_v1_8_ram1_tdp.v"/>
            <file pathname="ram1_tdp.v"/>
        </source>
    </file_list>
</ip_inst>
